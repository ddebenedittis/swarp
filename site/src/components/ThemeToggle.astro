---
/**
 * Floating light/dark/device theme switch, mirroring the one on
 * ddebenedittis.github.io. Cycles device -> light -> dark and writes the
 * choice to `data-theme` on <html>, which is the attribute both the `dark:`
 * custom variant in global.css and Expressive Code's `themeCssSelector`
 * already key off. The no-flash counterpart lives inline in index.astro.
 */
import { Icon } from "astro-icon/components";
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Switch colour theme"
  title="Switch colour theme"
  class="not-prose fixed top-3 right-4 z-50 flex h-10 w-10 items-center justify-center rounded-full bg-white/80 text-zinc-800 shadow-lg ring-1 ring-black/10 backdrop-blur transition hover:bg-white dark:bg-zinc-800/80 dark:text-zinc-100 dark:ring-white/15 dark:hover:bg-zinc-800"
>
  <Icon name="ri:computer-line" class="hidden text-xl" data-theme-icon="device" />
  <Icon name="ri:sun-line" class="hidden text-xl" data-theme-icon="light" />
  <Icon name="ri:moon-line" class="hidden text-xl" data-theme-icon="dark" />
</button>

<script>
  const ORDER = ["device", "light", "dark"] as const;
  type Theme = (typeof ORDER)[number];

  const isTheme = (value: string | null | undefined): value is Theme =>
    value === "device" || value === "light" || value === "dark";

  const root = document.documentElement;
  const button = document.getElementById("theme-toggle");

  if (button) {
    const icons = button.querySelectorAll<HTMLElement>("[data-theme-icon]");

    const paint = (theme: Theme) => {
      root.dataset.theme = theme;
      icons.forEach((icon) => {
        icon.classList.toggle("hidden", icon.dataset.themeIcon !== theme);
      });
    };

    /* The inline script has already applied any stored choice, so the
       attribute on <html> is the source of truth at this point. */
    paint(isTheme(root.dataset.theme) ? root.dataset.theme : "device");

    button.addEventListener("click", () => {
      const current = isTheme(root.dataset.theme) ? root.dataset.theme : "device";
      const next = ORDER[(ORDER.indexOf(current) + 1) % ORDER.length]!;
      try {
        localStorage.setItem("theme", next);
      } catch {
        /* Private browsing can refuse writes; the switch still works for this page view. */
      }
      paint(next);
    });
  }
</script>
